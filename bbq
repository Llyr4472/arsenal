#!/bin/bash
# ══════════════════════════════════════════════════════════════
#  bbq — Bug Bounty Queue  v1.0
#  Multi-target background manager for recon.sh + scan.sh
#
#  COMMANDS
#  ────────────────────────────────────────────────────────────
#  bbq recon  <target> [opts]   Queue recon job
#  bbq scan   <target> [opts]   Queue vuln scan job
#  bbq pipe   <target> [opts]   Queue full pipeline (recon → scan)
#  bbq fresh  <target> [opts]   Same as pipe but with --fresh
#
#  bbq status  / bbq ls         Show all jobs + state
#  bbq watch                    Live auto-refreshing status board
#  bbq logs   <target> [type]   Tail live log (type: recon|scan)
#  bbq report <target>          Print report paths / open HTML
#
#  bbq pause   <target>         Pause at next checkpoint
#  bbq unpause <target>         Resume paused scan
#  bbq stop    <target>         Stop cleanly (state preserved)
#  bbq retry   <target> [opts]  Re-queue (resumes from checkpoint)
#  bbq remove  <target>         Remove from queue entirely
#
#  bbq daemon                   Start background daemon
#  bbq daemon-stop              Stop daemon
#  bbq daemon-status            Check daemon
# ══════════════════════════════════════════════════════════════

# ──────────────────────────────────────────
# COLORS
# ──────────────────────────────────────────
GREEN='\033[0;32m'; YELLOW='\033[1;33m'; RED='\033[0;31m'
BLUE='\033[0;34m';  CYAN='\033[0;36m';   MAGENTA='\033[0;35m'
BOLD='\033[1m';     DIM='\033[2m';       RESET='\033[0m'

# ──────────────────────────────────────────
# PATHS
# ──────────────────────────────────────────
QUEUE_DIR="$HOME/.bbq"
QUEUE_FILE="$QUEUE_DIR/queue.tsv"   # target | type | status | pid | added_at | opts
DAEMON_PID_FILE="$QUEUE_DIR/daemon.pid"
DAEMON_LOG="$QUEUE_DIR/daemon.log"
SCRIPT_DIR="$HOME/arsenal"
RECON_SH="$SCRIPT_DIR/recon.sh"
SCAN_SH="$SCRIPT_DIR/scan.sh"

mkdir -p "$QUEUE_DIR"
touch "$QUEUE_FILE"

# ──────────────────────────────────────────
# LOGGING
# ──────────────────────────────────────────
log_info()    { echo -e "${BLUE}[*]${RESET} $1"; }
log_success() { echo -e "${GREEN}[+]${RESET} $1"; }
log_warn()    { echo -e "${YELLOW}[!]${RESET} $1"; }
log_error()   { echo -e "${RED}[✗]${RESET} $1"; }

# ──────────────────────────────────────────
# BANNER
# ──────────────────────────────────────────
print_banner() {
    echo -e "${RED}${BOLD}"
    echo "  ██████╗ ██████╗  ██████╗ "
    echo "  ██╔══██╗██╔══██╗██╔═══██╗"
    echo "  ██████╔╝██████╔╝██║   ██║"
    echo "  ██╔══██╗██╔══██╗██║▄▄ ██║"
    echo "  ██████╔╝██████╔╝╚██████╔╝"
    echo "  ╚═════╝ ╚═════╝  ╚══▀▀═╝  Bug Bounty Queue v1.0"
    echo -e "${RESET}"
}

# ──────────────────────────────────────────
# USAGE
# ──────────────────────────────────────────
usage() {
    print_banner
    echo -e "${BOLD}Usage:${RESET} bbq <command> [target] [options]"
    echo ""
    echo -e "${CYAN}${BOLD}Queue Commands:${RESET}"
    echo "  recon  <target> [opts]    Queue recon only"
    echo "  scan   <target> [opts]    Queue vuln scan only (needs prior recon)"
    echo "  pipe   <target> [opts]    Queue recon → scan pipeline"
    echo "  fresh  <target> [opts]    Queue fresh pipeline (wipes previous state)"
    echo ""
    echo -e "${CYAN}${BOLD}Monitor:${RESET}"
    echo "  status  / ls              Show all jobs and their state"
    echo "  watch                     Live auto-refreshing status board"
    echo "  logs  <target> [recon|scan]  Tail live log output"
    echo "  report <target>           Show report paths + summary"
    echo ""
    echo -e "${CYAN}${BOLD}Control:${RESET}"
    echo "  pause   <target>          Pause at next checkpoint"
    echo "  unpause <target>          Resume a paused job"
    echo "  stop    <target>          Stop cleanly (state preserved for resume)"
    echo "  retry   <target> [opts]   Re-queue stopped/failed job (auto-resumes)"
    echo "  remove  <target>          Remove all jobs for target"
    echo ""
    echo -e "${CYAN}${BOLD}Daemon:${RESET}"
    echo "  daemon                    Start background daemon"
    echo "  daemon-stop               Stop daemon"
    echo "  daemon-status             Check if daemon is running"
    echo ""
    echo -e "${CYAN}${BOLD}Recon Options (passthrough to recon.sh):${RESET}"
    echo "  --threads <n>  --rate-limit <n>  --wordlist <p>"
    echo "  --skip-brute   --skip-perms      --skip-crawl  --no-pv"
    echo ""
    echo -e "${CYAN}${BOLD}Scan Options (passthrough to scan.sh):${RESET}"
    echo "  --invasive  --threads <n>  --rate <n>  --severity <s>"
    echo "  --skip-nuclei  --skip-js  --skip-ffuf  --skip-gf"
    echo ""
    echo -e "${CYAN}${BOLD}Examples:${RESET}"
    echo "  bbq pipe target1.com"
    echo "  bbq pipe target2.com --invasive --threads 100"
    echo "  bbq recon target3.com --skip-brute"
    echo "  bbq scan  target3.com --skip-nuclei"
    echo "  bbq watch"
    echo "  bbq logs target1.com recon"
    echo "  bbq report target1.com"
    echo ""
    echo -e "${DIM}Targets are processed sequentially. Add at any time — they queue automatically.${RESET}"
    exit 0
}

# ──────────────────────────────────────────
# QUEUE OPERATIONS
# TSV columns: target | type | status | pid | added_at | opts
# ──────────────────────────────────────────
# status values: queued | waiting | running | paused | done | failed | stopped

q_get_line()  { grep "^${1}	" "$QUEUE_FILE" 2>/dev/null; }
q_get_field() { q_get_line "$1" | grep "	${2}	" | cut -f"$3"; }

# Get field by column number for a specific target+type combo
q_field() {
    local target="$1" type="$2" col="$3"
    grep "^${target}	${type}	" "$QUEUE_FILE" 2>/dev/null | tail -1 | cut -f"$col"
}

q_status() { q_field "$1" "$2" 3; }

q_set() {
    # q_set target type new_status [new_pid]
    local target="$1" type="$2" new_status="$3" new_pid="${4:-}"
    local added_at opts
    added_at=$(grep "^${target}	${type}	" "$QUEUE_FILE" 2>/dev/null | tail -1 | cut -f5)
    opts=$(grep "^${target}	${type}	" "$QUEUE_FILE" 2>/dev/null | tail -1 | cut -f6)
    [ -z "$added_at" ] && added_at=$(date '+%Y-%m-%d %H:%M:%S')

    grep -v "^${target}	${type}	" "$QUEUE_FILE" > "${QUEUE_FILE}.tmp" \
        && mv "${QUEUE_FILE}.tmp" "$QUEUE_FILE"
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$target" "$type" "$new_status" "$new_pid" "$added_at" "$opts" >> "$QUEUE_FILE"
}

q_add() {
    local target="$1" type="$2" status="${3:-queued}" opts="${4:-}"
    local added_at
    added_at=$(date '+%Y-%m-%d %H:%M:%S')

    # Check for duplicate
    if grep -q "^${target}	${type}	" "$QUEUE_FILE" 2>/dev/null; then
        local existing
        existing=$(grep "^${target}	${type}	" "$QUEUE_FILE" | tail -1 | cut -f3)
        log_warn "'${BOLD}${target}${RESET}' (${type}) already in queue: ${BOLD}$existing${RESET}"
        log_warn "Use 'retry' to re-queue or 'remove' to clear it first."
        return 1
    fi

    printf '%s\t%s\t%s\t\t%s\t%s\n' \
        "$target" "$type" "$status" "$added_at" "$opts" >> "$QUEUE_FILE"
    log_success "Queued [${CYAN}${type}${RESET}]: ${BOLD}$target${RESET}  ${DIM}$opts${RESET}"
    return 0
}

q_remove_all() {
    grep -v "^${1}	" "$QUEUE_FILE" > "${QUEUE_FILE}.tmp" \
        && mv "${QUEUE_FILE}.tmp" "$QUEUE_FILE"
}

q_next() {
    # Returns: target|type of next queued job (simple sequential)
    grep -m1 $'	queued	' "$QUEUE_FILE" 2>/dev/null | cut -f1,2 | tr '	' '|'
}

q_count() {
    local status="${1:-}"
    if [ -n "$status" ]; then
        grep -c "	${status}	" "$QUEUE_FILE" 2>/dev/null || echo 0
    else
        grep -c . "$QUEUE_FILE" 2>/dev/null || echo 0
    fi
}

# ──────────────────────────────────────────
# DAEMON
# ──────────────────────────────────────────
daemon_running() {
    [ -f "$DAEMON_PID_FILE" ] && kill -0 "$(cat "$DAEMON_PID_FILE")" 2>/dev/null
}

daemon_start() {
    if daemon_running; then
        log_info "Daemon already running (PID: $(cat "$DAEMON_PID_FILE"))"
        return
    fi
    log_info "Starting bbq daemon..."

    # Fully detach via double-fork + setsid
    (
        setsid bash -c "
            echo \$\$ > '$DAEMON_PID_FILE'
            exec >> '$DAEMON_LOG' 2>&1
            echo '[BBQ DAEMON] Started at $(date)'

            while true; do

                # ── Stale process cleanup ──────────────────
                while IFS=\$'\\t' read -r t type status pid added_at opts; do
                    [ \"\$status\" != 'running' ] && continue
                    [ -z \"\$pid\" ] && continue
                    kill -0 \"\$pid\" 2>/dev/null && continue

                    # Dead process — check what it wrote to .scan_status
                    sf=\"\$HOME/bb/\${t}/.scan_status\"
                    [ -f \"\$sf\" ] && final=\$(cat \"\$sf\") || final='failed'

                    echo \"[BBQ DAEMON] \$t [\$type] PID \$pid died. Final: \$final\"
                    grep -v \"^\${t}\t\${type}\t\" '$QUEUE_FILE' > '${QUEUE_FILE}.tmp' \
                        && mv '${QUEUE_FILE}.tmp' '$QUEUE_FILE'
                    printf '%s\t%s\t%s\t\t%s\t%s\n' \"\$t\" \"\$type\" \"\$final\" \
                        \"\$(date '+%Y-%m-%d %H:%M:%S')\" \"\$opts\" >> '$QUEUE_FILE'

                    # If recon just finished successfully, promote waiting scan
                    if [ \"\$type\" = 'recon' ] && [ \"\$final\" = 'done' ]; then
                        if grep -q \"^\${t}\tscan\twaiting\t\" '$QUEUE_FILE' 2>/dev/null; then
                            grep -v \"^\${t}\tscan\twaiting\t\" '$QUEUE_FILE' > '${QUEUE_FILE}.tmp' \
                                && mv '${QUEUE_FILE}.tmp' '$QUEUE_FILE'
                            scan_opts=\$(grep \"^\${t}\tscan\t\" '$QUEUE_FILE' 2>/dev/null | tail -1 | cut -f6)
                            printf '%s\tscan\tqueued\t\t%s\t%s\n' \"\$t\" \
                                \"\$(date '+%Y-%m-%d %H:%M:%S')\" \"\$scan_opts\" >> '$QUEUE_FILE'
                            echo \"[BBQ DAEMON] Promoted \$t [scan] from waiting to queued\"
                        fi
                    fi
                done < '$QUEUE_FILE'

                # ── Promote waiting scans if recon is done ─
                while IFS=\$'\\t' read -r t type status pid added_at opts; do
                    [ \"\$type\" != 'scan' ] || [ \"\$status\" != 'waiting' ] && continue
                    # Check if recon for this target is done
                    recon_status=\$(grep \"^\${t}\trecon\t\" '$QUEUE_FILE' 2>/dev/null | tail -1 | cut -f3)
                    if [ \"\$recon_status\" = 'done' ]; then
                        grep -v \"^\${t}\tscan\twaiting\t\" '$QUEUE_FILE' > '${QUEUE_FILE}.tmp' \
                            && mv '${QUEUE_FILE}.tmp' '$QUEUE_FILE'
                        printf '%s\tscan\tqueued\t\t%s\t%s\n' \"\$t\" \
                            \"\$(date '+%Y-%m-%d %H:%M:%S')\" \"\$opts\" >> '$QUEUE_FILE'
                        echo \"[BBQ DAEMON] Promoted \$t [scan] → queued (recon done)\"
                    fi
                done < '$QUEUE_FILE'

                # ── Pick next queued job ───────────────────
                NEXT_LINE=\$(grep -m1 \$'\\tqueued\\t' '$QUEUE_FILE' 2>/dev/null)
                [ -z \"\$NEXT_LINE\" ] && { sleep 5; continue; }

                NEXT_TARGET=\$(echo \"\$NEXT_LINE\" | cut -f1)
                NEXT_TYPE=\$(echo \"\$NEXT_LINE\"   | cut -f2)
                NEXT_OPTS=\$(echo \"\$NEXT_LINE\"    | cut -f6)

                case \"\$NEXT_TYPE\" in
                    recon) SCRIPT='$RECON_SH' ;;
                    scan)  SCRIPT='$SCAN_SH'  ;;
                    *)
                        echo \"[BBQ DAEMON] Unknown type '\$NEXT_TYPE' for \$NEXT_TARGET — skipping.\"
                        grep -v \"^\${NEXT_TARGET}\t\${NEXT_TYPE}\tqueued\t\" '$QUEUE_FILE' > '${QUEUE_FILE}.tmp' \
                            && mv '${QUEUE_FILE}.tmp' '$QUEUE_FILE'
                        printf '%s\t%s\tfailed\t\t%s\t%s\n' \"\$NEXT_TARGET\" \"\$NEXT_TYPE\" \
                            \"\$(date '+%Y-%m-%d %H:%M:%S')\" \"\$NEXT_OPTS\" >> '$QUEUE_FILE'
                        continue
                        ;;
                esac

                LOG_FILE=\"\$HOME/bb/\${NEXT_TARGET}/\${NEXT_TYPE}.log\"
                mkdir -p \"\$HOME/bb/\${NEXT_TARGET}\"

                echo \"[BBQ DAEMON] Starting \$NEXT_TARGET [\$NEXT_TYPE] opts='\$NEXT_OPTS'\"
                setsid bash \"\$SCRIPT\" \"\$NEXT_TARGET\" \$NEXT_OPTS >> \"\$LOG_FILE\" 2>&1 &
                SCAN_PID=\$!
                echo \"[BBQ DAEMON] PID: \$SCAN_PID\"

                # Mark as running
                grep -v \"^\${NEXT_TARGET}\t\${NEXT_TYPE}\tqueued\t\" '$QUEUE_FILE' > '${QUEUE_FILE}.tmp' \
                    && mv '${QUEUE_FILE}.tmp' '$QUEUE_FILE'
                printf '%s\t%s\trunning\t%s\t%s\t%s\n' \"\$NEXT_TARGET\" \"\$NEXT_TYPE\" \
                    \"\$SCAN_PID\" \"\$(date '+%Y-%m-%d %H:%M:%S')\" \"\$NEXT_OPTS\" >> '$QUEUE_FILE'

                # Wait for completion
                wait \$SCAN_PID
                EXIT_CODE=\$?

                sf=\"\$HOME/bb/\${NEXT_TARGET}/.scan_status\"
                [ -f \"\$sf\" ] && FINAL=\$(cat \"\$sf\") || {
                    [ \"\$EXIT_CODE\" -eq 0 ] && FINAL='done' || FINAL='failed'
                }

                echo \"[BBQ DAEMON] Finished \$NEXT_TARGET [\$NEXT_TYPE] → \$FINAL\"

                grep -v \"^\${NEXT_TARGET}\t\${NEXT_TYPE}\trunning\t\" '$QUEUE_FILE' > '${QUEUE_FILE}.tmp' \
                    && mv '${QUEUE_FILE}.tmp' '$QUEUE_FILE'
                printf '%s\t%s\t%s\t\t%s\t%s\n' \"\$NEXT_TARGET\" \"\$NEXT_TYPE\" \"\$FINAL\" \
                    \"\$(date '+%Y-%m-%d %H:%M:%S')\" \"\$NEXT_OPTS\" >> '$QUEUE_FILE'

                # Promote waiting scan if recon just finished
                if [ \"\$NEXT_TYPE\" = 'recon' ] && [ \"\$FINAL\" = 'done' ]; then
                    if grep -q \"^\${NEXT_TARGET}\tscan\twaiting\t\" '$QUEUE_FILE' 2>/dev/null; then
                        SCAN_OPTS=\$(grep \"^\${NEXT_TARGET}\tscan\twaiting\t\" '$QUEUE_FILE' | tail -1 | cut -f6)
                        grep -v \"^\${NEXT_TARGET}\tscan\twaiting\t\" '$QUEUE_FILE' > '${QUEUE_FILE}.tmp' \
                            && mv '${QUEUE_FILE}.tmp' '$QUEUE_FILE'
                        printf '%s\tscan\tqueued\t\t%s\t%s\n' \"\$NEXT_TARGET\" \
                            \"\$(date '+%Y-%m-%d %H:%M:%S')\" \"\$SCAN_OPTS\" >> '$QUEUE_FILE'
                        echo \"[BBQ DAEMON] Promoted \$NEXT_TARGET [scan] → queued\"
                    fi
                fi

            done
        " &
        disown
    )

    sleep 1
    if daemon_running; then
        log_success "Daemon started (PID: $(cat "$DAEMON_PID_FILE"))"
    else
        log_error "Daemon failed to start — check: $DAEMON_LOG"
    fi
}

daemon_stop() {
    if ! daemon_running; then
        log_warn "Daemon is not running."
        return
    fi
    local pid; pid=$(cat "$DAEMON_PID_FILE")
    kill "$pid" 2>/dev/null
    rm -f "$DAEMON_PID_FILE"
    log_success "Daemon stopped (was PID $pid)"
    log_warn "Running scans continue in background — they're independent of the daemon."
}

daemon_status_cmd() {
    if daemon_running; then
        log_success "Daemon RUNNING (PID: $(cat "$DAEMON_PID_FILE"))"
    else
        log_warn "Daemon NOT running."
        local n; n=$(q_count "queued")
        [ "$n" -gt 0 ] && log_warn "$n job(s) queued but daemon is stopped. Run: bbq daemon"
    fi
}

# ──────────────────────────────────────────
# STATUS DISPLAY
# ──────────────────────────────────────────
# Status color helper
status_color() {
    case "$1" in
        running)  echo "${GREEN}" ;;
        queued)   echo "${CYAN}" ;;
        waiting)  echo "${BLUE}" ;;
        done)     echo "${BLUE}" ;;
        failed)   echo "${RED}" ;;
        stopped)  echo "${YELLOW}" ;;
        paused)   echo "${MAGENTA}" ;;
        *)        echo "${RESET}" ;;
    esac
}

# Status icon
status_icon() {
    case "$1" in
        running)  echo "▶" ;;
        queued)   echo "⏳" ;;
        waiting)  echo "⏸ " ;;
        done)     echo "✔" ;;
        failed)   echo "✖" ;;
        stopped)  echo "■" ;;
        paused)   echo "⏸ " ;;
        *)        echo "?" ;;
    esac
}

# Get step progress for a target+type
step_progress() {
    local target="$1" type="$2"
    local state_file
    if [ "$type" = "recon" ]; then
        state_file="$HOME/bb/${target}/.recon_steps"
        local total=7
    else
        state_file="$HOME/bb/${target}/.scan_steps"
        local total=12
    fi
    [ ! -f "$state_file" ] && echo "" && return
    local done_count; done_count=$(wc -l < "$state_file")
    local last_step; last_step=$(tail -1 "$state_file" 2>/dev/null | sed 's/phase_[0-9]*_//' | sed 's/_/ /g')
    echo "${done_count}/${total} (${last_step})"
}

cmd_status() {
    echo ""
    echo -e "${RED}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    echo -e "${RED}${BOLD}  🔴 BBQ STATUS BOARD${RESET}"
    echo -e "${RED}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    printf "  Daemon: "
    if daemon_running; then
        echo -e "${GREEN}${BOLD}RUNNING${RESET} (PID: $(cat "$DAEMON_PID_FILE"))"
    else
        echo -e "${RED}STOPPED${RESET}  ← run: bbq daemon"
    fi

    echo ""
    printf "  %-30s %-6s %-12s %-8s %-22s\n" "TARGET" "TYPE" "STATUS" "PID" "PROGRESS / LAST STEP"
    echo -e "  ${DIM}$(printf '%.0s─' {1..80})${RESET}"

    if [ ! -s "$QUEUE_FILE" ]; then
        echo -e "  ${DIM}(no jobs in queue)${RESET}"
    else
        while IFS=$'\t' read -r target type status pid added_at opts; do
            [ -z "$target" ] && continue

            # Real-time pause check
            if [ "$status" = "running" ] && [ -f "$HOME/bb/${target}/.paused" ]; then
                status="paused"
            fi

            local color; color=$(status_color "$status")
            local icon;  icon=$(status_icon  "$status")
            local progress; progress=$(step_progress "$target" "$type")

            printf "  %-30s ${CYAN}%-6s${RESET} ${color}%-12s${RESET} %-8s %s\n" \
                "$target" "$type" "${icon} ${status}" "${pid:-—}" "$progress"

            # Show options if non-empty
            if [ -n "$opts" ]; then
                printf "  %-30s ${DIM}%s${RESET}\n" "" "opts: $opts"
            fi

        done < "$QUEUE_FILE"
    fi

    echo ""
    echo -e "  ${BOLD}Total: $(q_count)${RESET}  |  Queued: $(q_count queued)  Running: $(q_count running)  Done: $(q_count done)  Failed: $(q_count failed)  Waiting: $(q_count waiting)"
    echo -e "${RED}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    echo ""
    echo -e "  ${DIM}bbq watch — live refresh  |  bbq logs <target>  |  bbq report <target>${RESET}"
    echo ""
}

# ──────────────────────────────────────────
# WATCH (live refresh)
# ──────────────────────────────────────────
cmd_watch() {
    local interval="${1:-3}"
    echo -e "${DIM}Watching queue every ${interval}s — Ctrl+C to exit${RESET}"
    while true; do
        clear
        cmd_status
        echo -e "  ${DIM}Auto-refresh every ${interval}s  [$(date '+%H:%M:%S')]${RESET}"
        sleep "$interval"
    done
}

# ──────────────────────────────────────────
# LOGS
# ──────────────────────────────────────────
cmd_logs() {
    local target="$1" type="${2:-}"

    if [ -z "$type" ]; then
        # Auto-detect: prefer running job, else most recent
        if grep -q "^${target}	recon	running" "$QUEUE_FILE" 2>/dev/null; then
            type="recon"
        elif grep -q "^${target}	scan	running" "$QUEUE_FILE" 2>/dev/null; then
            type="scan"
        else
            # Show both if no running job
            echo -e "${BOLD}Available logs for ${CYAN}${target}${RESET}:"
            [ -f "$HOME/bb/${target}/recon.log" ] && echo "  recon → $HOME/bb/${target}/recon.log"
            [ -f "$HOME/bb/${target}/scan.log" ]  && echo "  scan  → $HOME/bb/${target}/scan.log"
            echo ""
            echo "  Usage: bbq logs $target [recon|scan]"
            return
        fi
    fi

    local log_file="$HOME/bb/${target}/${type}.log"
    if [ ! -f "$log_file" ]; then
        log_warn "Log not found: $log_file"
        log_warn "Has the $type job started? Check: bbq status"
        return 1
    fi

    echo -e "${BOLD}Tailing ${CYAN}${type}${RESET} log for ${BOLD}${target}${RESET} — Ctrl+C to stop"
    echo -e "${DIM}${log_file}${RESET}\n"
    tail -f "$log_file"
}

# ──────────────────────────────────────────
# REPORT
# ──────────────────────────────────────────
cmd_report() {
    local target="$1"
    local out_dir="$HOME/bb/${target}"
    local report_md="${out_dir}/report/report.md"
    local report_html="${out_dir}/report/report.html"

    echo ""
    echo -e "${RED}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    echo -e "${RED}${BOLD}  REPORT — ${target}${RESET}"
    echo -e "${RED}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"

    # Recon summary from file counts
    echo -e "\n  ${CYAN}${BOLD}[ RECON ]${RESET}"
    local recon_files=(
        "passive_raw.txt:Passive subs"
        "brute_subs.txt:Bruteforce subs"
        "final_subdomains.txt:Final subdomains"
        "web_alive.txt:Live web servers"
        "clean_urls.txt:Unique URLs"
        "final_params.txt:URLs w/ params"
    )
    for entry in "${recon_files[@]}"; do
        local file="${entry%%:*}" label="${entry##*:}"
        local path="${out_dir}/${file}"
        if [ -f "$path" ]; then
            printf "  %-28s ${BOLD}%s${RESET}\n" "$label" "$(wc -l < "$path")"
        fi
    done

    # Vuln scan summary from file counts
    echo -e "\n  ${RED}${BOLD}[ VULN SCAN ]${RESET}"
    local vuln_dir="${out_dir}/vulns"
    if [ -d "$vuln_dir" ]; then
        local vuln_files=(
            "nuclei_vulns.txt:Nuclei vulns"
            "nuclei_exposures.txt:Nuclei exposures"
            "nuclei_takeovers.txt:Subdomain takeovers"
            "js_secrets.txt:JS secrets"
            "cors_findings.txt:CORS issues"
            "confirmed_redirects.txt:Open redirects"
            "confirmed_ssrf.txt:SSRF confirmed"
            "confirmed_lfi.txt:LFI confirmed"
            "dalfox_xss.txt:XSS (Dalfox)"
            "403_bypass.txt:403 bypasses"
        )
        for entry in "${vuln_files[@]}"; do
            local file="${entry%%:*}" label="${entry##*:}"
            local path="${vuln_dir}/${file}"
            if [ -f "$path" ]; then
                local count; count=$(wc -l < "$path")
                local color="${RESET}"
                [ "$count" -gt 0 ] && {
                    case "$file" in
                        nuclei_vulns.txt|nuclei_takeovers.txt|js_secrets.txt|confirmed_ssrf.txt|confirmed_lfi.txt|dalfox_xss.txt)
                            color="${RED}" ;;
                        cors_findings.txt|confirmed_redirects.txt|403_bypass.txt)
                            color="${YELLOW}" ;;
                    esac
                }
                printf "  %-28s ${color}${BOLD}%s${RESET}\n" "$label" "$count"
            fi
        done
    else
        echo -e "  ${DIM}Vuln scan not yet run.${RESET}"
    fi

    echo ""
    echo -e "  ${BOLD}Report files:${RESET}"
    [ -f "$report_md"   ] && echo -e "  ${GREEN}✔${RESET} Markdown : $report_md"   || echo -e "  ${DIM}✗ Markdown not found${RESET}"
    [ -f "$report_html" ] && echo -e "  ${GREEN}✔${RESET} HTML     : $report_html" || echo -e "  ${DIM}✗ HTML not found${RESET}"
    echo -e "  ${BOLD}Output dir   :${RESET} $out_dir"
    echo -e "${RED}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    echo ""
}

# ──────────────────────────────────────────
# PAUSE / UNPAUSE
# ──────────────────────────────────────────
cmd_pause() {
    local target="$1"
    touch "$HOME/bb/${target}/.paused"
    log_success "Pause signal sent → ${BOLD}$target${RESET}"
    log_info "Will pause at next checkpoint (within ~15s)."
    log_info "Resume: bbq unpause $target"
}

cmd_unpause() {
    local target="$1"
    rm -f "$HOME/bb/${target}/.paused"
    log_success "Unpause signal sent → ${BOLD}$target${RESET}"
    log_info "Scan will resume from last checkpoint."
}

# ──────────────────────────────────────────
# STOP
# ──────────────────────────────────────────
cmd_stop() {
    local target="$1"

    # Kill all running jobs for this target
    local killed=false
    while IFS=$'\t' read -r t type status pid rest; do
        [ "$t" != "$target" ] || [ "$status" != "running" ] && continue
        [ -z "$pid" ] && continue

        # Try scan_pid file first (more reliable)
        local pid_file="$HOME/bb/${target}/.scan_pid"
        [ -f "$pid_file" ] && pid=$(cat "$pid_file")

        if kill -0 "$pid" 2>/dev/null; then
            kill -TERM "$pid" 2>/dev/null
            sleep 2
            kill -0 "$pid" 2>/dev/null && kill -KILL "$pid" 2>/dev/null
            log_success "Stopped ${BOLD}$target${RESET} [$type] (PID: $pid)"
            killed=true
        fi

        # Kill watchdog
        local wp="$HOME/bb/${target}/.watchdog_pid"
        [ -f "$wp" ] && kill "$(cat "$wp")" 2>/dev/null && rm -f "$wp"

        q_set "$target" "$type" "stopped" ""
    done < "$QUEUE_FILE"

    $killed || log_warn "No running process found for '$target' (may already be stopped)."
    log_info "State preserved. Re-queue with: bbq retry $target"
}

# ──────────────────────────────────────────
# REMOVE
# ──────────────────────────────────────────
cmd_remove() {
    local target="$1"
    # Stop if running first
    if grep -q "^${target}	" "$QUEUE_FILE" 2>/dev/null | grep -q "	running	"; then
        log_warn "Stopping running job first..."
        cmd_stop "$target"
    fi
    q_remove_all "$target"
    log_success "Removed all jobs for '${BOLD}$target${RESET}' from queue."
}

# ──────────────────────────────────────────
# RETRY
# ──────────────────────────────────────────
cmd_retry() {
    local target="$1"; shift
    local extra_opts="$*"

    # Check target exists in queue
    if ! grep -q "^${target}	" "$QUEUE_FILE" 2>/dev/null; then
        log_error "Target '$target' not found in queue. Use 'bbq pipe/recon/scan' to add it."
        return 1
    fi

    # Re-queue each job for this target (except done recon in pipeline — keep it)
    while IFS=$'\t' read -r t type status pid added_at opts; do
        [ "$t" != "$target" ] && continue
        local combined_opts
        combined_opts=$(echo "$opts $extra_opts" | xargs)

        grep -v "^${target}	${type}	" "$QUEUE_FILE" > "${QUEUE_FILE}.tmp" \
            && mv "${QUEUE_FILE}.tmp" "$QUEUE_FILE"

        # For scan that was waiting, re-check if recon is done
        if [ "$type" = "scan" ]; then
            local recon_status
            recon_status=$(grep "^${target}	recon	" "$QUEUE_FILE" 2>/dev/null | tail -1 | cut -f3)
            if [ "$recon_status" = "done" ] || [ -z "$recon_status" ]; then
                printf '%s\t%s\tqueued\t\t%s\t%s\n' "$target" "$type" \
                    "$(date '+%Y-%m-%d %H:%M:%S')" "$combined_opts" >> "$QUEUE_FILE"
            else
                printf '%s\t%s\twaiting\t\t%s\t%s\n' "$target" "$type" \
                    "$(date '+%Y-%m-%d %H:%M:%S')" "$combined_opts" >> "$QUEUE_FILE"
            fi
        else
            printf '%s\t%s\tqueued\t\t%s\t%s\n' "$target" "$type" \
                "$(date '+%Y-%m-%d %H:%M:%S')" "$combined_opts" >> "$QUEUE_FILE"
        fi
        log_success "Re-queued [${CYAN}${type}${RESET}]: ${BOLD}$target${RESET} (will resume from last checkpoint)"
    done < <(grep "^${target}	" "$QUEUE_FILE")

    daemon_running || daemon_start
}

# ──────────────────────────────────────────
# ADD COMMANDS
# ──────────────────────────────────────────
check_scripts() {
    local ok=true
    [ ! -f "$RECON_SH" ] && { log_error "recon.sh not found at: $RECON_SH"; ok=false; }
    [ ! -f "$SCAN_SH"  ] && { log_error "scan.sh not found at: $SCAN_SH";   ok=false; }
    $ok || { log_error "Ensure all scripts are in the same directory as bbq."; exit 1; }
}

cmd_recon() {
    local target="$1"; shift
    local opts="$*"
    [ -z "$target" ] && { log_error "Usage: bbq recon <target> [opts]"; exit 1; }
    check_scripts
    q_add "$target" "recon" "queued" "$opts" || return 1
    daemon_running || daemon_start
    echo ""; cmd_status
}

cmd_scan() {
    local target="$1"; shift
    local opts="$*"
    [ -z "$target" ] && { log_error "Usage: bbq scan <target> [opts]"; exit 1; }
    check_scripts

    # Check if recon is done for this target
    local recon_done=false
    if grep -q "^${target}	recon	done	" "$QUEUE_FILE" 2>/dev/null; then
        recon_done=true
    elif [ -f "$HOME/bb/${target}/.recon_steps" ]; then
        # Recon state file exists from a prior run outside bbq
        recon_done=true
    fi

    if $recon_done; then
        q_add "$target" "scan" "queued" "$opts" || return 1
    else
        log_warn "Recon not done for '$target'. Scan job will wait for recon."
        q_add "$target" "scan" "waiting" "$opts" || return 1
    fi

    daemon_running || daemon_start
    echo ""; cmd_status
}

cmd_pipe() {
    local target="$1"; shift
    local opts="$*"
    [ -z "$target" ] && { log_error "Usage: bbq pipe <target> [opts]"; exit 1; }
    check_scripts

    local added=false
    q_add "$target" "recon" "queued"  "$opts" && added=true
    q_add "$target" "scan"  "waiting" "$opts"   # scan waits for recon

    $added || return 1
    daemon_running || daemon_start
    echo ""; cmd_status
}

cmd_fresh() {
    local target="$1"; shift
    local opts="--fresh $*"
    [ -z "$target" ] && { log_error "Usage: bbq fresh <target> [opts]"; exit 1; }
    check_scripts

    # Remove any existing jobs and re-add as fresh pipeline
    q_remove_all "$target"

    q_add "$target" "recon" "queued"  "$opts"
    q_add "$target" "scan"  "waiting" "$opts"

    daemon_running || daemon_start
    echo ""; cmd_status
}

# ──────────────────────────────────────────
# MAIN DISPATCH
# ──────────────────────────────────────────
[ "$#" -eq 0 ] && { usage; }

CMD="$1"; shift

case "$CMD" in
    # Queue
    recon)          cmd_recon "$@" ;;
    scan)           cmd_scan  "$@" ;;
    pipe)           cmd_pipe  "$@" ;;
    fresh)          cmd_fresh "$@" ;;

    # Monitor
    status|ls)      cmd_status ;;
    watch)          cmd_watch "$@" ;;
    logs|log)       cmd_logs "$@" ;;
    report)         cmd_report "${1:?Usage: bbq report <target>}" ;;

    # Control
    pause)          cmd_pause   "${1:?Usage: bbq pause <target>}" ;;
    unpause|resume) cmd_unpause "${1:?Usage: bbq unpause <target>}" ;;
    stop)           cmd_stop    "${1:?Usage: bbq stop <target>}" ;;
    retry)          cmd_retry "$@" ;;
    remove|rm)      cmd_remove  "${1:?Usage: bbq remove <target>}" ;;

    # Daemon
    daemon)         daemon_start ;;
    daemon-stop)    daemon_stop ;;
    daemon-status)  daemon_status_cmd ;;

    -h|--help|help) usage ;;
    *)
        log_error "Unknown command: $CMD"
        echo ""
        usage
        ;;
esac
