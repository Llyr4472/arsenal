#!/bin/bash
# ══════════════════════════════════════════════════════════════
#  bbq — Bug Bounty Queue v4.0
#  Queue:    pipe | recon | scan
#  Monitor:  status | watch | logs | stats
#  Control:  pause | unpause | stop | retry | remove
#  Rescue:   fix | kill-all
#  Config:   config [set KEY VAL]
#  Daemon:   daemon | daemon-stop | daemon-status
# ══════════════════════════════════════════════════════════════
set -o noglob

GREEN='\033[0;32m'; YELLOW='\033[1;33m'; RED='\033[0;31m'
BLUE='\033[0;34m';  CYAN='\033[0;36m';   MAGENTA='\033[0;35m'
BOLD='\033[1m';     DIM='\033[2m';       RESET='\033[0m'

QUEUE_DIR="$HOME/.bbq"
QUEUE_FILE="$QUEUE_DIR/queue.tsv"
CONFIG_FILE="$QUEUE_DIR/config"
DAEMON_PID_FILE="$QUEUE_DIR/daemon.pid"
DAEMON_WORKER="$QUEUE_DIR/daemon_worker.sh"
DAEMON_LOG="$QUEUE_DIR/daemon.log"
DAEMON_HEARTBEAT="$QUEUE_DIR/daemon.heartbeat"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RECON_SH="$SCRIPT_DIR/recon.sh"
SCAN_SH="$SCRIPT_DIR/scan.sh"
BB_DIR="$HOME/bb"

mkdir -p "$QUEUE_DIR"
touch "$QUEUE_FILE"

log_info()    { echo -e "${BLUE}[*]${RESET} $1"; }
log_success() { echo -e "${GREEN}[+]${RESET} $1"; }
log_warn()    { echo -e "${YELLOW}[!]${RESET} $1"; }
log_error()   { echo -e "${RED}[x]${RESET} $1"; }

# ══ CONFIG ════════════════════════════════════════════════════
DEFAULT_CONFIG='# bbq config
MAX_JOBS=2
MAX_SCAN_JOBS=1
THREAD_BUDGET=40
RATE_BUDGET=60
LOAD_LIMIT=3
MIN_RAM_MB=400
NICE_LEVEL=10
USE_IONICE=1
'

init_config() {
    [ -f "$CONFIG_FILE" ] || printf '%s' "$DEFAULT_CONFIG" > "$CONFIG_FILE"
}

load_config() {
    init_config
    # shellcheck disable=SC1090
    source "$CONFIG_FILE" 2>/dev/null
    MAX_JOBS="${MAX_JOBS:-2}"
    MAX_SCAN_JOBS="${MAX_SCAN_JOBS:-1}"
    THREAD_BUDGET="${THREAD_BUDGET:-40}"
    RATE_BUDGET="${RATE_BUDGET:-60}"
    LOAD_LIMIT="${LOAD_LIMIT:-3}"
    MIN_RAM_MB="${MIN_RAM_MB:-400}"
    NICE_LEVEL="${NICE_LEVEL:-10}"
    USE_IONICE="${USE_IONICE:-1}"
}

config_set() {
    init_config
    if grep -q "^${1}=" "$CONFIG_FILE"; then
        sed -i "s|^${1}=.*|${1}=${2}|" "$CONFIG_FILE"
    else
        echo "${1}=${2}" >> "$CONFIG_FILE"
    fi
    log_success "Set ${BOLD}${1}${RESET} = ${CYAN}${2}${RESET}"
}

cmd_config() {
    [ "$1" = "set" ] && { config_set "$2" "$3"; return; }
    load_config
    local nproc
    nproc=$(nproc 2>/dev/null || echo 4)
    echo ""
    echo -e "${RED}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    echo -e "${RED}${BOLD}  BBQ CONFIG${RESET}  ${DIM}$CONFIG_FILE${RESET}"
    echo -e "${RED}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    printf "  %-22s ${CYAN}%-6s${RESET}  ${DIM}%s${RESET}\n" "MAX_JOBS"      "$MAX_JOBS"      "total concurrent slots"
    printf "  %-22s ${CYAN}%-6s${RESET}  ${DIM}%s${RESET}\n" "MAX_SCAN_JOBS" "$MAX_SCAN_JOBS" "max parallel scans (keep 1)"
    printf "  %-22s ${CYAN}%-6s${RESET}  ${DIM}%s${RESET}\n" "THREAD_BUDGET" "$THREAD_BUDGET" "-> $((THREAD_BUDGET/MAX_JOBS))/job at $MAX_JOBS concurrent"
    printf "  %-22s ${CYAN}%-6s${RESET}  ${DIM}%s${RESET}\n" "RATE_BUDGET"   "$RATE_BUDGET"   "-> $((RATE_BUDGET/MAX_JOBS))/job at $MAX_JOBS concurrent"
    printf "  %-22s ${CYAN}%-6s${RESET}  ${DIM}%s${RESET}\n" "LOAD_LIMIT"    "$LOAD_LIMIT"    "hold spawns at load >$LOAD_LIMIT ($nproc cores)"
    printf "  %-22s ${CYAN}%-6s${RESET}  ${DIM}%s${RESET}\n" "MIN_RAM_MB"    "$MIN_RAM_MB"    "hold <${MIN_RAM_MB}MB free"
    printf "  %-22s ${CYAN}%-6s${RESET}  ${DIM}%s${RESET}\n" "NICE_LEVEL"    "$NICE_LEVEL"    "0=normal 10=lower 19=lowest"
    printf "  %-22s ${CYAN}%-6s${RESET}  ${DIM}%s${RESET}\n" "USE_IONICE"    "$USE_IONICE"    "idle I/O class (1=on)"
    echo ""
    echo -e "  ${DIM}Example: bbq config set MAX_JOBS 1${RESET}"
    echo -e "${RED}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    echo ""
}

# ══ RESOURCES ════════════════════════════════════════════════
get_load_int() { awk '{printf "%d", $1*10}' /proc/loadavg 2>/dev/null || echo 0; }
get_free_ram()  { awk '/MemAvailable/{print int($2/1024)}' /proc/meminfo 2>/dev/null || echo 9999; }
get_total_ram() { awk '/MemTotal/{print int($2/1024)}' /proc/meminfo 2>/dev/null || echo 0; }

ok_to_spawn() {
    load_config
    [ "$(get_free_ram)" -lt "$MIN_RAM_MB"          ] && return 1
    [ "$(get_load_int)" -gt $(( LOAD_LIMIT * 10 )) ] && return 1
    return 0
}

resources_str() {
    load_config
    local ld li free lx lc rc
    ld=$(awk '{printf "%.1f", $1}' /proc/loadavg 2>/dev/null || echo "?")
    li=$(get_load_int)
    free=$(get_free_ram)
    lx=$(( LOAD_LIMIT * 10 ))
    lc="${GREEN}"; rc="${GREEN}"
    [ "$free" -lt "$MIN_RAM_MB"      ] && rc="${RED}"    || [ "$free" -lt $(( MIN_RAM_MB*2 )) ] && rc="${YELLOW}"
    [ "$li"   -gt "$lx"              ] && lc="${RED}"    || [ "$li"   -gt $(( lx*7/10 ))     ] && lc="${YELLOW}"
    echo -e "load: ${lc}${ld}${RESET}/${LOAD_LIMIT}  ram: ${rc}${free}MB${RESET} free"
}

# ══ QUEUE ════════════════════════════════════════════════════
# TSV format: target  type  status  pid  added_at  opts
q_write()  { mv "${QUEUE_FILE}.tmp" "$QUEUE_FILE"; }
q_field()  { grep "^${1}	${2}	" "$QUEUE_FILE" 2>/dev/null | tail -1 | cut -f"$3"; }

q_set() {
    local tgt="$1" type="$2" st="$3" pid="${4:-}"
    local at opts
    at=$(q_field "$tgt" "$type" 5)
    [ -z "$at" ] && at=$(date '+%Y-%m-%d %H:%M:%S')
    opts=$(q_field "$tgt" "$type" 6)
    grep -v "^${tgt}	${type}	" "$QUEUE_FILE" > "${QUEUE_FILE}.tmp"
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$tgt" "$type" "$st" "$pid" "$at" "$opts" >> "${QUEUE_FILE}.tmp"
    q_write
}

q_add() {
    local tgt="$1" type="$2" st="${3:-queued}" opts="${4:-}"
    if grep -q "^${tgt}	${type}	" "$QUEUE_FILE" 2>/dev/null; then
        local e
        e=$(q_field "$tgt" "$type" 3)
        log_warn "'${BOLD}${tgt}${RESET}' ($type) already in queue: ${BOLD}$e${RESET} — use 'retry' or 'remove'"
        return 1
    fi
    printf '%s\t%s\t%s\t\t%s\t%s\n' "$tgt" "$type" "$st" "$(date '+%Y-%m-%d %H:%M:%S')" "$opts" >> "$QUEUE_FILE"
    log_success "Queued [${CYAN}${type}${RESET}]: ${BOLD}$tgt${RESET}  ${DIM}$opts${RESET}"
}

q_remove_all() { grep -v "^${1}	" "$QUEUE_FILE" > "${QUEUE_FILE}.tmp" && q_write; }

q_count() {
    local s="${1:-}" n
    if [ -n "$s" ]; then
        n=$(grep -c "	${s}	" "$QUEUE_FILE" 2>/dev/null) || n=0
    else
        n=$(grep -c '.' "$QUEUE_FILE" 2>/dev/null) || n=0
    fi
    echo "${n:-0}"
}

# ══ PID / KILL HELPERS ═══════════════════════════════════════
pid_alive() { [ -n "$1" ] && [ "$1" -gt 0 ] 2>/dev/null && kill -0 "$1" 2>/dev/null; }

get_real_pid() {
    local p
    p=$(cat "$BB_DIR/${1}/.scan_pid" 2>/dev/null)
    [ -n "$p" ] && echo "$p" && return
    q_field "$1" "$2" 4
}

get_pgid() {
    local pgid
    pgid=$(cat "$BB_DIR/${2}/.scan_pgid" 2>/dev/null)
    [ -n "$pgid" ] && [ "$pgid" -gt 1 ] 2>/dev/null && echo "$pgid" && return
    pgid=$(ps -o pgid= -p "$1" 2>/dev/null | tr -d ' ')
    [ -n "$pgid" ] && [ "$pgid" -gt 1 ] 2>/dev/null && echo "$pgid"
}

kill_job() {
    local tgt="$1" rp="$2" sig="${3:-TERM}"
    local pgid
    pgid=$(get_pgid "$rp" "$tgt")
    if [ -n "$pgid" ]; then
        kill -"$sig" -- -"$pgid" 2>/dev/null
    else
        kill -"$sig" "$rp" 2>/dev/null
    fi
    # Named sweep for orphaned children
    pkill -"$sig" -f "nuclei.*${tgt}"    2>/dev/null
    pkill -"$sig" -f "mantra"            2>/dev/null
    pkill -"$sig" -f "katana.*${tgt}"    2>/dev/null
    pkill -"$sig" -f "ffuf.*${tgt}"      2>/dev/null
    pkill -"$sig" -f "httpx.*${tgt}"     2>/dev/null
    pkill -"$sig" -f "naabu.*${tgt}"     2>/dev/null
    pkill -"$sig" -f "dnsx.*${tgt}"      2>/dev/null
    pkill -"$sig" -f "subfinder.*${tgt}" 2>/dev/null
}

# ══ RECON COMPLETION CHECK ════════════════════════════════════
recon_is_done() {
    local tgt="$1" out="$BB_DIR/${1}"
    [ "$(q_field "$tgt" "recon" 3)" = "done" ] && return 0
    [ -f "${out}/final_subdomains.txt" ] && [ -s "${out}/final_subdomains.txt" ] && return 0
    return 1
}

# ══ FIX ══════════════════════════════════════════════════════
cmd_fix() {
    echo ""
    echo -e "${RED}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    echo -e "${RED}${BOLD}  BBQ FIX${RESET}"
    echo -e "${RED}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    local fixed=0

    while IFS=$'\t' read -r tgt type status pid at opts; do
        [ -z "$tgt" ] && continue
        case "$status" in
        running)
            local rpid
            rpid=$(get_real_pid "$tgt" "$type")
            if pid_alive "$rpid"; then
                echo -e "  ${GREEN}OK${RESET}  $tgt [$type] PID=$rpid alive"
            else
                kill_job "$tgt" "${rpid:-0}" KILL
                local sf final steps
                sf="$BB_DIR/${tgt}/.scan_status"
                final=$([ -f "$sf" ] && cat "$sf" || echo "stopped")
                steps=0
                [ -f "$BB_DIR/${tgt}/.${type}_steps" ] && steps=$(wc -l < "$BB_DIR/${tgt}/.${type}_steps")
                echo -e "  ${YELLOW}FIX${RESET} $tgt [$type] PID=$rpid dead -> $final ($steps steps done)"
                q_set "$tgt" "$type" "$final" ""
                rm -f "$BB_DIR/${tgt}/.sys_paused"
                (( fixed++ )) || true
            fi
            ;;
        paused)
            local rpid
            rpid=$(get_real_pid "$tgt" "$type")
            if ! pid_alive "$rpid"; then
                kill_job "$tgt" "${rpid:-0}" KILL
                echo -e "  ${YELLOW}FIX${RESET} $tgt [$type] paused but PID=$rpid dead -> stopped"
                q_set "$tgt" "$type" "stopped" ""
                rm -f "$BB_DIR/${tgt}/.paused" "$BB_DIR/${tgt}/.sys_paused"
                (( fixed++ )) || true
            else
                echo -e "  ${GREEN}OK${RESET}  $tgt [$type] paused, process alive"
            fi
            ;;
        waiting)
            if recon_is_done "$tgt"; then
                echo -e "  ${CYAN}FIX${RESET} $tgt [scan] waiting but recon done -> queued"
                q_set "$tgt" "$type" "queued" ""
                (( fixed++ )) || true
            fi
            ;;
        esac
    done < "$QUEUE_FILE"

    if [ -f "$DAEMON_PID_FILE" ] && ! pid_alive "$(cat "$DAEMON_PID_FILE" 2>/dev/null)"; then
        rm -f "$DAEMON_PID_FILE"
        echo -e "  ${YELLOW}FIX${RESET} Removed stale daemon PID file"
        (( fixed++ )) || true
    fi

    echo ""
    [ "$fixed" -eq 0 ] \
        && log_success "Queue is consistent — nothing to fix." \
        || log_success "$fixed issue(s) fixed."
    echo ""
    [ "$fixed" -gt 0 ] && {
        log_info "Retry stopped jobs: bbq retry <target>"
        log_info "Restart daemon:     bbq daemon"
    }
    echo ""
}

# ══ KILL-ALL ══════════════════════════════════════════════════
cmd_kill_all() {
    echo ""
    log_warn "Stopping ALL running jobs..."
    if daemon_running; then
        local dp
        dp=$(cat "$DAEMON_PID_FILE")
        kill "$dp" 2>/dev/null
        rm -f "$DAEMON_PID_FILE"
        log_success "Daemon stopped (PID $dp)"
    fi
    while IFS=$'\t' read -r tgt type status pid rest; do
        [ "$status" != "running" ] && continue
        local rpid
        rpid=$(get_real_pid "$tgt" "$type")
        if pid_alive "$rpid"; then
            kill_job "$tgt" "$rpid" TERM
            sleep 1
            pid_alive "$rpid" && kill_job "$tgt" "$rpid" KILL
        else
            kill_job "$tgt" "${rpid:-0}" KILL
        fi
        log_success "Killed $tgt [$type] PID=${rpid:---}"
        local wp="$BB_DIR/${tgt}/.watchdog_pid"
        [ -f "$wp" ] && kill "$(cat "$wp")" 2>/dev/null
        rm -f "$wp" "$BB_DIR/${tgt}/.paused" "$BB_DIR/${tgt}/.sys_paused"
        q_set "$tgt" "$type" "stopped" ""
    done < "$QUEUE_FILE"
    echo ""
    log_success "Done. Resume with: bbq retry <target>"
    echo ""
}

# ══ DAEMON ════════════════════════════════════════════════════
daemon_running() {
    [ -f "$DAEMON_PID_FILE" ] && pid_alive "$(cat "$DAEMON_PID_FILE" 2>/dev/null)"
}

daemon_heartbeat_ok() {
    [ ! -f "$DAEMON_HEARTBEAT" ] && return 1
    local now mtime
    now=$(date +%s)
    mtime=$(date -r "$DAEMON_HEARTBEAT" +%s 2>/dev/null || echo 0)
    [ $(( now - mtime )) -lt 60 ]
}

write_daemon_worker() {
    cat > "$DAEMON_WORKER" << 'END_WORKER'
#!/bin/bash
# bbq daemon worker — auto-generated

QUEUE_FILE="__QUEUE_FILE__"
CONFIG_FILE="__CONFIG_FILE__"
RECON_SH="__RECON_SH__"
SCAN_SH="__SCAN_SH__"
DAEMON_PID_FILE="__DAEMON_PID_FILE__"
DAEMON_LOG="__DAEMON_LOG__"
DAEMON_HEARTBEAT="__DAEMON_HEARTBEAT__"
BB_DIR="$HOME/bb"

echo $$ > "$DAEMON_PID_FILE"
exec >> "$DAEMON_LOG" 2>&1
echo "[$(date '+%Y-%m-%d %H:%M:%S')] [BBQ] Daemon started PID=$$"

load_cfg() {
    # shellcheck disable=SC1090
    source "$CONFIG_FILE" 2>/dev/null
    MAX_JOBS="${MAX_JOBS:-2}"
    MAX_SCAN_JOBS="${MAX_SCAN_JOBS:-1}"
    THREAD_BUDGET="${THREAD_BUDGET:-40}"
    RATE_BUDGET="${RATE_BUDGET:-60}"
    LOAD_LIMIT="${LOAD_LIMIT:-3}"
    MIN_RAM_MB="${MIN_RAM_MB:-400}"
    NICE_LEVEL="${NICE_LEVEL:-10}"
    USE_IONICE="${USE_IONICE:-1}"
}

get_load_int() { awk '{printf "%d", $1*10}' /proc/loadavg 2>/dev/null || echo 0; }
get_free_ram()  { awk '/MemAvailable/{print int($2/1024)}' /proc/meminfo 2>/dev/null || echo 9999; }
pid_alive()     { [ -n "$1" ] && [ "$1" -gt 0 ] 2>/dev/null && kill -0 "$1" 2>/dev/null; }

get_real_pid() {
    local p
    p=$(cat "$BB_DIR/${1}/.scan_pid" 2>/dev/null)
    [ -n "$p" ] && echo "$p" && return
    grep "^${1}	${2}	" "$QUEUE_FILE" 2>/dev/null | tail -1 | cut -f4
}

get_pgid() {
    local pgid
    pgid=$(cat "$BB_DIR/${2}/.scan_pgid" 2>/dev/null)
    [ -n "$pgid" ] && [ "$pgid" -gt 1 ] 2>/dev/null && echo "$pgid" && return
    pgid=$(ps -o pgid= -p "$1" 2>/dev/null | tr -d ' ')
    [ -n "$pgid" ] && [ "$pgid" -gt 1 ] 2>/dev/null && echo "$pgid"
}

kill_job() {
    local tgt="$1" rp="$2" sig="${3:-TERM}"
    local pgid
    pgid=$(get_pgid "$rp" "$tgt")
    if [ -n "$pgid" ]; then
        kill -"$sig" -- -"$pgid" 2>/dev/null
    else
        kill -"$sig" "$rp" 2>/dev/null
    fi
    pkill -"$sig" -f "nuclei.*${tgt}"    2>/dev/null
    pkill -"$sig" -f "mantra"            2>/dev/null
    pkill -"$sig" -f "katana.*${tgt}"    2>/dev/null
    pkill -"$sig" -f "ffuf.*${tgt}"      2>/dev/null
    pkill -"$sig" -f "httpx.*${tgt}"     2>/dev/null
    pkill -"$sig" -f "naabu.*${tgt}"     2>/dev/null
    pkill -"$sig" -f "dnsx.*${tgt}"      2>/dev/null
    pkill -"$sig" -f "subfinder.*${tgt}" 2>/dev/null
}

ok_to_spawn() {
    [ "$(get_free_ram)" -lt "$MIN_RAM_MB"          ] && return 1
    [ "$(get_load_int)" -gt $(( LOAD_LIMIT * 10 )) ] && return 1
    return 0
}

spawn_prefix() {
    local p="nice -n ${NICE_LEVEL}"
    [ "${USE_IONICE}" = "1" ] && command -v ionice &>/dev/null \
        && p="ionice -c 3 nice -n ${NICE_LEVEL}"
    echo "$p"
}

inject_resources() {
    local type="$1" running="$2" opts="$3"
    local total=$(( running + 1 ))
    [ "$total" -lt 1 ] && total=1
    local t=$(( THREAD_BUDGET / total ))
    [ "$t" -lt 5  ] && t=5
    local r=$(( RATE_BUDGET / total ))
    [ "$r" -lt 10 ] && r=10
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [BBQ] $total active -> ${t}t ${r}r each" >> "$DAEMON_LOG"
    echo "$opts" | grep -q -- '--threads'    || opts="$opts --threads $t"
    if [ "$type" = "recon" ]; then
        echo "$opts" | grep -q -- '--rate-limit' || opts="$opts --rate-limit $r"
    else
        echo "$opts" | grep -qE -- '--rate[^-]'  || opts="$opts --rate $r"
    fi
    echo "$opts"
}

recon_is_done() {
    local out="$BB_DIR/${1}"
    local rs
    rs=$(grep "^${1}	recon	" "$QUEUE_FILE" 2>/dev/null | tail -1 | cut -f3)
    [ "$rs" = "done" ] && return 0
    [ -f "${out}/final_subdomains.txt" ] && [ -s "${out}/final_subdomains.txt" ] && return 0
    return 1
}

# Promote scan jobs from waiting -> queued when recon finishes
# Reads to a temp array first to avoid modifying-while-iterating
promote_waiting() {
    local to_promote=()
    while IFS=$'\t' read -r t type status pid at opts; do
        [ "$type" = "scan" ] && [ "$status" = "waiting" ] || continue
        recon_is_done "$t" || continue
        to_promote+=("$t	$opts")
    done < "$QUEUE_FILE"

    for entry in "${to_promote[@]}"; do
        local t opts
        t="${entry%%	*}"
        opts="${entry#*	}"
        grep -v "^${t}	scan	waiting	" "$QUEUE_FILE" > "${QUEUE_FILE}.tmp" \
            && mv "${QUEUE_FILE}.tmp" "$QUEUE_FILE"
        printf '%s\tscan\tqueued\t\t%s\t%s\n' \
            "$t" "$(date '+%Y-%m-%d %H:%M:%S')" "$opts" >> "$QUEUE_FILE"
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] [BBQ] Promoted $t [scan] -> queued"
    done
}

# Clean up dead running jobs — reads snapshot to avoid loop/modify race
cleanup_dead() {
    local snapshot
    snapshot=$(grep $'\trunning\t' "$QUEUE_FILE" 2>/dev/null) || return 0
    [ -z "$snapshot" ] && return 0

    while IFS=$'\t' read -r t type status pid at opts; do
        local rpid
        rpid=$(get_real_pid "$t" "$type")
        [ -z "$rpid" ] && rpid="$pid"
        pid_alive "$rpid" && continue

        kill_job "$t" "${rpid:-0}" KILL

        local sf final steps
        sf="$BB_DIR/${t}/.scan_status"
        final=$([ -f "$sf" ] && cat "$sf" || echo "failed")
        steps=0
        [ -f "$BB_DIR/${t}/.${type}_steps" ] && steps=$(wc -l < "$BB_DIR/${t}/.${type}_steps" 2>/dev/null)
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] [BBQ] Dead: $t [$type] PID=$rpid -> $final ($steps steps)"

        grep -v "^${t}	${type}	running	" "$QUEUE_FILE" > "${QUEUE_FILE}.tmp" \
            && mv "${QUEUE_FILE}.tmp" "$QUEUE_FILE"
        printf '%s\t%s\t%s\t\t%s\t%s\n' \
            "$t" "$type" "$final" "$(date '+%Y-%m-%d %H:%M:%S')" "$opts" >> "$QUEUE_FILE"

        rm -f "$BB_DIR/${t}/.sys_paused"
        [ "$type" = "recon" ] && [ "$final" = "done" ] && promote_waiting
    done <<< "$snapshot"
}

# Main loop
while true; do
    touch "$DAEMON_HEARTBEAT"
    load_cfg
    cleanup_dead
    promote_waiting

    local_running=$(grep -c $'\trunning\t' "$QUEUE_FILE" 2>/dev/null) || local_running=0
    local_running_scans=$(grep -c $'\tscan\trunning\t' "$QUEUE_FILE" 2>/dev/null) || local_running_scans=0

    if [ "$local_running" -lt "$MAX_JOBS" ]; then
        if ! ok_to_spawn; then
            echo "[$(date '+%Y-%m-%d %H:%M:%S')] [BBQ] Resource gate: load=$(get_load_int) ram=$(get_free_ram)MB — holding"
            sleep 15
            continue
        fi

        # Find next queued job
        NEXT_T=""
        NEXT_TYPE=""
        NEXT_OPTS=""
        while IFS=$'\t' read -r t type status pid at opts; do
            [ "$status" != "queued" ] && continue
            [ "$type" = "scan" ] && [ "$local_running_scans" -ge "$MAX_SCAN_JOBS" ] && continue
            NEXT_T="$t"
            NEXT_TYPE="$type"
            NEXT_OPTS="$opts"
            break
        done < "$QUEUE_FILE"

        if [ -n "$NEXT_T" ]; then
            case "$NEXT_TYPE" in
                recon) SCRIPT="$RECON_SH" ;;
                scan)  SCRIPT="$SCAN_SH"  ;;
                *)
                    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [BBQ] Unknown type '$NEXT_TYPE' for $NEXT_T — failing"
                    grep -v "^${NEXT_T}	${NEXT_TYPE}	queued	" "$QUEUE_FILE" > "${QUEUE_FILE}.tmp" \
                        && mv "${QUEUE_FILE}.tmp" "$QUEUE_FILE"
                    printf '%s\t%s\tfailed\t\t%s\t%s\n' \
                        "$NEXT_T" "$NEXT_TYPE" "$(date '+%Y-%m-%d %H:%M:%S')" "$NEXT_OPTS" >> "$QUEUE_FILE"
                    continue
                    ;;
            esac

            FINAL_OPTS=$(inject_resources "$NEXT_TYPE" "$local_running" "$NEXT_OPTS")
            PREFIX=$(spawn_prefix)
            LOG="$BB_DIR/${NEXT_T}/${NEXT_TYPE}.log"
            mkdir -p "$BB_DIR/${NEXT_T}"

            echo "[$(date '+%Y-%m-%d %H:%M:%S')] [BBQ] Spawning $NEXT_T [$NEXT_TYPE] slot=$((local_running+1))/$MAX_JOBS opts='$FINAL_OPTS'"

            setsid $PREFIX bash "$SCRIPT" "$NEXT_T" $FINAL_OPTS >> "$LOG" 2>&1 &
            SCAN_PID=$!
            echo "[$(date '+%Y-%m-%d %H:%M:%S')] [BBQ] PID=$SCAN_PID log=$LOG"

            grep -v "^${NEXT_T}	${NEXT_TYPE}	queued	" "$QUEUE_FILE" > "${QUEUE_FILE}.tmp" \
                && mv "${QUEUE_FILE}.tmp" "$QUEUE_FILE"
            printf '%s\t%s\trunning\t%s\t%s\t%s\n' \
                "$NEXT_T" "$NEXT_TYPE" "$SCAN_PID" \
                "$(date '+%Y-%m-%d %H:%M:%S')" "$NEXT_OPTS" >> "$QUEUE_FILE"

            sleep 3
            continue
        fi
    fi

    sleep 5
done
END_WORKER

    sed -i \
        -e "s|__QUEUE_FILE__|${QUEUE_FILE}|g" \
        -e "s|__CONFIG_FILE__|${CONFIG_FILE}|g" \
        -e "s|__RECON_SH__|${RECON_SH}|g" \
        -e "s|__SCAN_SH__|${SCAN_SH}|g" \
        -e "s|__DAEMON_PID_FILE__|${DAEMON_PID_FILE}|g" \
        -e "s|__DAEMON_LOG__|${DAEMON_LOG}|g" \
        -e "s|__DAEMON_HEARTBEAT__|${DAEMON_HEARTBEAT}|g" \
        "$DAEMON_WORKER"
    chmod +x "$DAEMON_WORKER"
}

daemon_start() {
    if daemon_running; then
        log_info "Daemon already running (PID: $(cat "$DAEMON_PID_FILE"))"
        return
    fi

    local stale
    stale=$(grep -c $'\trunning\t' "$QUEUE_FILE" 2>/dev/null) || stale=0
    [ "$stale" -gt 0 ] && {
        log_warn "$stale stale 'running' entries — running fix first..."
        cmd_fix
    }

    init_config
    load_config
    log_info "Starting daemon (MAX_JOBS=${MAX_JOBS} MAX_SCAN_JOBS=${MAX_SCAN_JOBS} NICE=${NICE_LEVEL})..."
    write_daemon_worker
    ( setsid bash "$DAEMON_WORKER" & disown )
    sleep 1
    if daemon_running; then
        log_success "Daemon started (PID: $(cat "$DAEMON_PID_FILE"))"
    else
        log_error "Daemon failed to start — check: $DAEMON_LOG"
    fi
}

daemon_stop() {
    if ! daemon_running; then
        log_warn "Daemon not running."
        return
    fi
    local p
    p=$(cat "$DAEMON_PID_FILE")
    kill "$p" 2>/dev/null
    rm -f "$DAEMON_PID_FILE"
    log_success "Daemon stopped (was PID $p)"
    log_info "Running scans continue independently."
}

daemon_status_cmd() {
    if daemon_running; then
        load_config
        log_success "Daemon RUNNING (PID: $(cat "$DAEMON_PID_FILE"))"
        if daemon_heartbeat_ok; then
            local age
            age=$(( $(date +%s) - $(date -r "$DAEMON_HEARTBEAT" +%s 2>/dev/null || echo 0) ))
            log_info "Heartbeat: ${age}s ago — responsive"
        else
            log_warn "Heartbeat stale — daemon may be hung"
            log_warn "Run: bbq kill-all && bbq daemon"
        fi
        log_info "MAX_JOBS=${MAX_JOBS}  MAX_SCAN_JOBS=${MAX_SCAN_JOBS}  NICE=${NICE_LEVEL}"
    else
        log_warn "Daemon NOT running."
        local n
        n=$(q_count "queued")
        [ "$n" -gt 0 ] && log_warn "$n queued — run: bbq daemon"
    fi
}

# ══ STATUS ════════════════════════════════════════════════════
sc() {
    case "$1" in
        running) echo "${GREEN}"   ;; queued)  echo "${CYAN}"    ;;
        waiting) echo "${BLUE}"    ;; done)    echo "${DIM}"     ;;
        failed)  echo "${RED}"     ;; stopped) echo "${YELLOW}"  ;;
        paused)  echo "${MAGENTA}" ;; *)       echo "${RESET}"   ;;
    esac
}
si() {
    case "$1" in
        running) echo ">>" ;; queued)  echo "::" ;; waiting) echo ".." ;;
        done)    echo "OK" ;; failed)  echo "!!" ;; stopped) echo "--" ;;
        paused)  echo "||" ;; *)       echo "?"  ;;
    esac
}

step_prog() {
    local f t
    if [ "$2" = "recon" ]; then
        f="$BB_DIR/${1}/.recon_steps"
        t=7
    else
        f="$BB_DIR/${1}/.scan_steps"
        t=12
    fi
    [ ! -f "$f" ] && return
    local n last
    n=$(wc -l < "$f")
    last=$(tail -1 "$f" 2>/dev/null | sed 's/phase_[0-9]*_//' | tr '_' ' ')
    echo "${n}/${t} — ${last}"
}

cmd_status() {
    load_config
    echo ""
    echo -e "${RED}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    echo -e "${RED}${BOLD}  BBQ STATUS${RESET}"
    echo -e "${RED}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    printf "  Daemon : "
    if daemon_running; then
        local hb=""
        if daemon_heartbeat_ok; then
            hb="  heartbeat OK"
        else
            hb="  ${RED}[STALE HEARTBEAT — run: bbq kill-all]${RESET}"
        fi
        echo -e "${GREEN}${BOLD}RUNNING${RESET} PID=$(cat "$DAEMON_PID_FILE")${hb}"
        echo -e "           slots: ${MAX_JOBS} (max ${MAX_SCAN_JOBS} scan)  budget: ${THREAD_BUDGET}t/${RATE_BUDGET}r"
    else
        echo -e "${RED}STOPPED${RESET}  ← run: bbq daemon"
    fi
    printf "  System : "; resources_str
    echo ""
    printf "  %-28s %-6s %-12s %-8s %s\n" "TARGET" "TYPE" "STATUS" "PID" "PROGRESS"
    echo -e "  ${DIM}$(printf '%.0s─' {1..74})${RESET}"

    if [ ! -s "$QUEUE_FILE" ]; then
        echo -e "  ${DIM}(queue is empty)${RESET}"
    else
        while IFS=$'\t' read -r tgt type status pid at opts; do
            [ -z "$tgt" ] && continue
            [ "$status" = "running" ] && [ -f "$BB_DIR/${tgt}/.paused" ] && status="paused"
            local c i prog dp
            c=$(sc "$status")
            i=$(si "$status")
            prog=$(step_prog "$tgt" "$type")
            dp=$(get_real_pid "$tgt" "$type")
            [ "$status" != "running" ] && [ "$status" != "paused" ] && dp="${pid:---}"
            printf "  %-28s ${CYAN}%-6s${RESET} ${c}%-12s${RESET} %-8s %s\n" \
                "$tgt" "$type" "${i} ${status}" "${dp:---}" "$prog"
            [ -n "$opts" ] && printf "  %-28s ${DIM}%s${RESET}\n" "" "$opts"
        done < "$QUEUE_FILE"
    fi

    echo ""
    local r mj
    r=$(q_count "running")
    mj="${MAX_JOBS:-2}"
    echo -e "  ${BOLD}Jobs :${RESET} $(q_count queued) queued  $r running  $(q_count done) done  $(q_count failed) failed  $(q_count stopped) stopped  $(q_count waiting) waiting"
    echo -e "  ${BOLD}Slots:${RESET} $r/${mj} in use  $(( mj - r )) free"
    echo -e "${RED}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    echo ""
    echo -e "  ${DIM}bbq watch | stats | fix | kill-all | logs <target> | config${RESET}"
    echo ""
}

cmd_watch() {
    local i="${1:-3}"
    echo -e "${DIM}Refreshing every ${i}s — Ctrl+C to exit${RESET}"
    sleep 1
    while true; do
        clear
        cmd_status
        echo -e "  ${DIM}[$(date '+%H:%M:%S')] Ctrl+C to exit${RESET}"
        sleep "$i"
    done
}

cmd_stats() {
    load_config
    local nproc ld li free total pct lx lc rc
    nproc=$(nproc 2>/dev/null || echo 4)
    ld=$(awk '{printf "%.1f %.1f", $1, $2}' /proc/loadavg 2>/dev/null || echo "? ?")
    li=$(get_load_int)
    free=$(get_free_ram)
    total=$(get_total_ram)
    pct=$(( (total-free)*100/(total+1) ))
    lx=$(( LOAD_LIMIT*10 ))
    lc="${GREEN}"; rc="${GREEN}"
    [ "$free" -lt "$MIN_RAM_MB"   ] && rc="${RED}"   || [ "$free" -lt $(( MIN_RAM_MB*2 )) ] && rc="${YELLOW}"
    [ "$li"   -gt "$lx"           ] && lc="${RED}"   || [ "$li"   -gt $(( lx*7/10 ))     ] && lc="${YELLOW}"
    echo ""
    echo -e "${RED}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    echo -e "${RED}${BOLD}  BBQ STATS${RESET}"
    echo -e "${RED}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    echo -e "  ${BOLD}CPU     :${RESET} $nproc cores"
    echo -e "  ${BOLD}Load    :${RESET} ${lc}${ld}${RESET} (1m 5m)  gate:>$LOAD_LIMIT"
    echo -e "  ${BOLD}RAM     :${RESET} ${rc}${free}MB free${RESET} / ${total}MB (${pct}% used)"
    echo -e "  ${BOLD}Gate    :${RESET} hold <${MIN_RAM_MB}MB free"
    echo ""
    local r
    r=$(q_count "running")
    echo -e "  ${BOLD}Slots   :${RESET} $r/${MAX_JOBS} in use (max ${MAX_SCAN_JOBS} scan)"
    echo -e "  ${BOLD}Threads :${RESET} ${THREAD_BUDGET} / ${MAX_JOBS} = $((THREAD_BUDGET/MAX_JOBS)) per job"
    echo -e "  ${BOLD}Rate    :${RESET} ${RATE_BUDGET} / ${MAX_JOBS} = $((RATE_BUDGET/MAX_JOBS)) per job"
    echo -e "  ${BOLD}Nice    :${RESET} $NICE_LEVEL  ionice: $USE_IONICE"
    local rj
    rj=$(grep $'\trunning\t' "$QUEUE_FILE" 2>/dev/null)
    if [ -n "$rj" ]; then
        echo ""
        echo -e "  ${BOLD}Running:${RESET}"
        while IFS=$'\t' read -r t type status pid rest; do
            local rp alive cm
            rp=$(get_real_pid "$t" "$type")
            if pid_alive "$rp"; then
                alive="${GREEN}alive${RESET}"
            else
                alive="${RED}DEAD (run: bbq fix)${RESET}"
            fi
            cm=""
            [ -n "$rp" ] && cm="  $(ps -p "$rp" -o %cpu,%mem --no-headers 2>/dev/null | xargs)%"
            echo -e "    ${CYAN}${t}${RESET} [$type]  PID=$rp  $alive$cm"
            local p
            p=$(step_prog "$t" "$type")
            [ -n "$p" ] && echo -e "    ${DIM}$p${RESET}"
        done <<< "$rj"
    fi
    echo -e "${RED}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    echo ""
}

cmd_logs() {
    local tgt="$1" type="${2:-}"
    if [ -z "$type" ]; then
        # Auto-detect which log to show: prefer running, else show both
        if grep -q "^${tgt}	recon	running" "$QUEUE_FILE" 2>/dev/null; then
            type="recon"
        elif grep -q "^${tgt}	scan	running" "$QUEUE_FILE" 2>/dev/null; then
            type="scan"
        else
            echo -e "${BOLD}Logs for ${CYAN}${tgt}${RESET}:"
            [ -f "$BB_DIR/${tgt}/recon.log" ] && echo "  recon → $BB_DIR/${tgt}/recon.log"
            [ -f "$BB_DIR/${tgt}/scan.log"  ] && echo "  scan  → $BB_DIR/${tgt}/scan.log"
            echo "  Usage: bbq logs $tgt [recon|scan]"
            return
        fi
    fi
    local f="$BB_DIR/${tgt}/${type}.log"
    [ ! -f "$f" ] && { log_warn "Not found: $f"; return 1; }
    echo -e "${BOLD}Tailing ${CYAN}${type}${RESET} log for ${BOLD}${tgt}${RESET} — Ctrl+C to stop"
    echo -e "${DIM}$f${RESET}\n"
    tail -f "$f"
}

cmd_report() {
    local tgt="$1" out="$BB_DIR/${1}"
    echo ""
    echo -e "${RED}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    echo -e "${RED}${BOLD}  REPORT — ${tgt}${RESET}"
    echo -e "${RED}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    echo -e "\n  ${CYAN}${BOLD}RECON${RESET}"
    for e in "passive_raw.txt:Passive subs" "brute_subs.txt:Bruteforce" \
             "final_subdomains.txt:Final subdomains" "web_alive.txt:Live web servers" \
             "clean_urls.txt:Unique URLs" "final_params.txt:URLs w/ params"; do
        [ -f "${out}/${e%%:*}" ] && \
            printf "  %-28s ${BOLD}%s${RESET}\n" "${e##*:}" "$(wc -l < "${out}/${e%%:*}")"
    done
    echo -e "\n  ${RED}${BOLD}VULN SCAN${RESET}"
    local vd="${out}/vulns"
    if [ -d "$vd" ]; then
        for e in "nuclei_vulns.txt:Nuclei vulns:h" "nuclei_takeovers.txt:Takeovers:c" \
                 "js_secrets.txt:JS secrets:h" "cors_findings.txt:CORS:m" \
                 "confirmed_ssrf.txt:SSRF:h" "confirmed_lfi.txt:LFI:h" \
                 "dalfox_xss.txt:XSS:h" "403_bypass.txt:403 bypass:m"; do
            IFS=: read -r f l sv <<< "$e"
            [ -f "${vd}/${f}" ] || continue
            local n c
            n=$(wc -l < "${vd}/${f}")
            c="${RESET}"
            [ "$n" -gt 0 ] && case "$sv" in
                c) c="${RED}${BOLD}" ;; h) c="${RED}" ;; m) c="${YELLOW}" ;;
            esac
            printf "  %-28s ${c}${BOLD}%s${RESET}\n" "$l" "$n"
        done
    else
        echo -e "  ${DIM}Vuln scan not yet run.${RESET}"
    fi
    echo ""
    [ -f "${out}/report/report.html" ] \
        && echo -e "  HTML : ${out}/report/report.html" \
        || echo -e "  ${DIM}report.html not generated yet${RESET}"
    echo -e "  Dir  : $out"
    echo -e "${RED}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    echo ""
}

# ══ CONTROL ═══════════════════════════════════════════════════
cmd_pause() {
    mkdir -p "$BB_DIR/${1}"
    touch "$BB_DIR/${1}/.paused"
    log_success "Pause → ${BOLD}$1${RESET}  (takes effect within ~15s)"
}

cmd_unpause() {
    rm -f "$BB_DIR/${1}/.paused" "$BB_DIR/${1}/.sys_paused"
    log_success "Unpause → ${BOLD}$1${RESET}"
}

cmd_stop() {
    local tgt="$1" killed=false
    while IFS=$'\t' read -r t type status pid rest; do
        [ "$t" != "$tgt" ] || [ "$status" != "running" ] && continue
        local rp
        rp=$(get_real_pid "$tgt" "$type")
        if pid_alive "$rp"; then
            kill_job "$tgt" "$rp" TERM
            sleep 2
            pid_alive "$rp" && kill_job "$tgt" "$rp" KILL
        else
            kill_job "$tgt" "${rp:-0}" KILL
        fi
        log_success "Stopped ${BOLD}$tgt${RESET} [$type] PID=${rp:---}"
        killed=true
        local wp="$BB_DIR/${tgt}/.watchdog_pid"
        [ -f "$wp" ] && kill "$(cat "$wp")" 2>/dev/null
        rm -f "$wp" "$BB_DIR/${tgt}/.paused" "$BB_DIR/${tgt}/.sys_paused"
        q_set "$tgt" "$type" "stopped" ""
    done < "$QUEUE_FILE"
    $killed || log_warn "No running process for '$tgt'. Try: bbq fix"
    log_info "Checkpoint saved — resume: bbq retry $tgt"
}

cmd_remove() {
    cmd_stop "$1" 2>/dev/null
    q_remove_all "$1"
    log_success "Removed '${BOLD}$1${RESET}' from queue."
}

cmd_retry() {
    local tgt="$1"
    shift
    local extra="$*"
    grep -q "^${tgt}	" "$QUEUE_FILE" 2>/dev/null || { log_error "'$tgt' not in queue."; return 1; }
    local entries
    entries=$(grep "^${tgt}	" "$QUEUE_FILE")
    while IFS=$'\t' read -r t type status pid at opts; do
        [ "$t" != "$tgt" ] && continue
        local combined
        combined=$(echo "$opts $extra" | xargs)
        grep -v "^${tgt}	${type}	" "$QUEUE_FILE" > "${QUEUE_FILE}.tmp" && q_write
        if [ "$type" = "scan" ] && ! recon_is_done "$tgt"; then
            printf '%s\t%s\twaiting\t\t%s\t%s\n' \
                "$tgt" "$type" "$(date '+%Y-%m-%d %H:%M:%S')" "$combined" >> "$QUEUE_FILE"
            log_success "Re-queued [$type]: ${BOLD}$tgt${RESET} — ${YELLOW}waiting for recon${RESET}"
        else
            printf '%s\t%s\tqueued\t\t%s\t%s\n' \
                "$tgt" "$type" "$(date '+%Y-%m-%d %H:%M:%S')" "$combined" >> "$QUEUE_FILE"
            log_success "Re-queued [$type]: ${BOLD}$tgt${RESET}"
        fi
    done <<< "$entries"
    daemon_running || daemon_start
}

# ══ ADD COMMANDS ══════════════════════════════════════════════
check_scripts() {
    local ok=true
    [ ! -f "$RECON_SH" ] && { log_error "recon.sh not found: $RECON_SH"; ok=false; }
    [ ! -f "$SCAN_SH"  ] && { log_error "scan.sh not found: $SCAN_SH";   ok=false; }
    $ok || { log_error "Scripts must be in the same directory as bbq."; exit 1; }
}

cmd_recon() {
    local tgt="$1"
    shift
    check_scripts
    [ -z "$tgt" ] && { log_error "Usage: bbq recon <target>"; exit 1; }
    q_add "$tgt" "recon" "queued" "$*" || return 1
    daemon_running || daemon_start
    echo ""
    cmd_status
}

cmd_scan() {
    local tgt="$1"
    shift
    check_scripts
    [ -z "$tgt" ] && { log_error "Usage: bbq scan <target>"; exit 1; }
    if recon_is_done "$tgt"; then
        log_info "Recon data found — queuing scan"
        q_add "$tgt" "scan" "queued" "$*" || return 1
    else
        log_warn "No recon data for '$tgt' — scan will wait for recon to complete"
        log_info "Start recon with: bbq recon $tgt"
        q_add "$tgt" "scan" "waiting" "$*" || return 1
    fi
    daemon_running || daemon_start
    echo ""
    cmd_status
}

cmd_pipe() {
    local tgt="$1"
    shift
    check_scripts
    [ -z "$tgt" ] && { log_error "Usage: bbq pipe <target>"; exit 1; }
    q_add "$tgt" "recon" "queued"  "$*" || return 1
    q_add "$tgt" "scan"  "waiting" "$*"
    daemon_running || daemon_start
    echo ""
    cmd_status
}

# ══ USAGE ═════════════════════════════════════════════════════
usage() {
    echo -e "${RED}${BOLD}  BBQ — Bug Bounty Queue v4.0${RESET}\n"
    echo -e "${BOLD}Usage:${RESET} bbq <command> [target] [options]\n"
    echo -e "${CYAN}${BOLD}Queue:${RESET}"
    echo "  pipe   <target> [opts]   recon → scan pipeline"
    echo "  recon  <target> [opts]   recon only"
    echo "  scan   <target> [opts]   scan only"
    echo ""
    echo -e "${CYAN}${BOLD}Monitor:${RESET}"
    echo "  status / ls              queue + resource overview"
    echo "  watch  [secs]            live auto-refresh (default 3s)"
    echo "  logs   <target> [type]   tail log (recon|scan)"
    echo "  stats                    CPU/RAM + running job details"
    echo "  report <target>          finding counts + output paths"
    echo ""
    echo -e "${CYAN}${BOLD}Control:${RESET}"
    echo "  pause   <target>         pause at next checkpoint"
    echo "  unpause <target>         resume"
    echo "  stop    <target>         stop + save checkpoint"
    echo "  retry   <target> [opts]  re-queue stopped/failed job"
    echo "  remove  <target>         remove from queue entirely"
    echo ""
    echo -e "${RED}${BOLD}Rescue:${RESET}"
    echo "  fix                      reconcile queue + kill orphaned processes"
    echo "  kill-all                 stop everything"
    echo ""
    echo -e "${CYAN}${BOLD}Settings:${RESET}"
    echo "  config                   show settings"
    echo "  config set MAX_JOBS 1    serial mode (safest)"
    echo ""
    echo -e "${CYAN}${BOLD}Daemon:${RESET}"
    echo "  daemon                   start"
    echo "  daemon-stop              stop (scans continue)"
    echo "  daemon-status            check + heartbeat"
    echo ""
    echo -e "${CYAN}${BOLD}Recovery:${RESET}"
    echo "  bbq kill-all && bbq fix && bbq daemon && bbq retry <target>"
    echo ""
    exit 0
}

# ══ DISPATCH ══════════════════════════════════════════════════
[ "$#" -eq 0 ] && usage
CMD="$1"; shift
case "$CMD" in
    pipe)           cmd_pipe    "$@" ;;
    recon)          cmd_recon   "$@" ;;
    scan)           cmd_scan    "$@" ;;
    status|ls)      cmd_status ;;
    watch)          cmd_watch   "$@" ;;
    logs|log)       cmd_logs    "$@" ;;
    stats)          cmd_stats ;;
    report)         cmd_report  "${1:?Usage: bbq report <target>}" ;;
    config)         cmd_config  "$@" ;;
    pause)          cmd_pause   "${1:?Usage: bbq pause <target>}" ;;
    unpause|resume) cmd_unpause "${1:?Usage: bbq unpause <target>}" ;;
    stop)           cmd_stop    "${1:?Usage: bbq stop <target>}" ;;
    retry)          cmd_retry   "$@" ;;
    remove|rm)      cmd_remove  "${1:?Usage: bbq remove <target>}" ;;
    fix)            cmd_fix ;;
    kill-all)       cmd_kill_all ;;
    daemon)         daemon_start ;;
    daemon-stop)    daemon_stop ;;
    daemon-status)  daemon_status_cmd ;;
    -h|--help|help) usage ;;
    *) log_error "Unknown command: $CMD"; echo ""; usage ;;
esac
